// Prisma Schema for DevMind Domain Architecture
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  name                String
  passwordHash        String?
  avatarUrl           String?
  role                String             @default("Developer")
  color               String             @default("#C8D62B")
  tokenVersion        Int                @default(0)
  onboardingCompleted Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  memberships         OrgMember[]
  learningProgress    LearningProgress[]
  githubAccount       GitHubAccount?
}

model GitHubAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  githubUserId String   @unique
  login        String
  name         String?
  avatarUrl    String?
  email        String?
  accessToken  String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  avatarUrl String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  members   OrgMember[]
  projects  Project[]
}

model OrgMember {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      String       @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model Project {
  id           String       @id @default(cuid())
  orgId        String
  name         String
  slug         String       @unique
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repositories Repository[]
}

model Repository {
  id                   String             @id @default(cuid())
  projectId            String
  name                 String
  owner                String
  defaultBranch        String             @default("main")
  isAnalyzed           Boolean            @default(true)
  ingestionStatus      String             @default("COMPLETED") // PENDING, INDEXING, COMPLETED, PARTIAL, FAILED
  ingestionError       String?
  startedAt            DateTime?
  completedAt          DateTime?
  embeddingStatus      String             @default("NOT_INDEXED") // NOT_INDEXED, INDEXING, COMPLETED, PARTIAL, FAILED
  embeddingError       String?
  indexedChunksCount   Int                @default(0)
  embeddingStartedAt   DateTime?
  embeddingCompletedAt DateTime?
  localPath            String?
  gitSyncStatus        String             @default("NOT_SYNCED") // NOT_SYNCED, SYNCING, COMPLETED, PARTIAL, FAILED
  gitSyncError         String?
  lastGitSyncAt        DateTime?
  latestCommitSha      String?
  lastSyncedCommitSha  String?
  lastSuccessfulSyncAt DateTime?
  syncStatus           String             @default("NOT_SYNCED") // NOT_SYNCED, SYNCING, COMPLETED, PARTIAL, FAILED
  syncError            String?
  lastSyncSummary      String?
  commitsCount         Int                @default(0)
  filesCount           Int                @default(0)
  modulesCount         Int                @default(0)
  depsCount            Int                @default(0)
  contributorsCount    Int                @default(0)
  lastIndexedAt        DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branches             Branch[]
  modules              Module[]
  fileRecords          FileRecord[]
  dependencyRecords    DependencyRecord[]
  developerRecords     DeveloperRecord[]
  documentRecords      DocumentRecord[]
  activityRecords      ActivityRecord[]
  documentChunks       DocumentChunk[]
  commits              CommitRecord[]
  contributors         ContributorRecord[]
  syncJobs             SyncJob[]

  @@index([projectId])
  @@index([owner, name])
  @@index([ingestionStatus])
  @@index([gitSyncStatus])
  @@index([syncStatus])
}

model Branch {
  id        String     @id @default(cuid())
  repoId    String
  name      String
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  repo      Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, name])
}

model Module {
  id               String       @id @default(cuid())
  repoId           String
  name             String
  type             String       // core, api, db, ext
  desc             String
  aiSummary        String?
  filesCount       Int          @default(0)
  depsCount        Int          @default(0)
  dependentsCount  Int          @default(0)
  createdAt        DateTime     @default(now())
  repo             Repository   @relation(fields: [repoId], references: [id], onDelete: Cascade)
  files            FileRecord[]

  @@index([repoId])
}

model FileRecord {
  id             String          @id @default(cuid())
  repoId         String
  moduleId       String?
  path           String
  size           String
  type           String          // code, doc, test
  language       String          @default("UNKNOWN")
  parsingStatus  String          @default("UNSUPPORTED") // PARSED, UNSUPPORTED, FAILED
  parsingError   String?
  lineCount      Int             @default(0)
  symbolsJson    String?         // Structured AST symbols JSON payload
  updatedText    String
  createdAt      DateTime        @default(now())
  repo           Repository      @relation(fields: [repoId], references: [id], onDelete: Cascade)
  module         Module?         @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  documentChunks DocumentChunk[]

  @@unique([repoId, path])
  @@index([repoId, language])
  @@index([repoId, parsingStatus])
  @@index([repoId, type])
  @@index([repoId, moduleId])
}

model DocumentChunk {
  id            String     @id @default(cuid())
  repoId        String
  fileId        String
  moduleId      String?
  path          String
  language      String
  content       String
  startLine     Int
  endLine       Int
  chunkIndex    Int
  contentHash   String
  embeddingJson String?    // JSON array of float vector values
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  repo          Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  file          FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([repoId, path, chunkIndex])
  @@index([fileId])
}

model DependencyRecord {
  id               String     @id @default(cuid())
  key              String?    @unique
  repoId           String
  kind             String     // internal, external
  sourceFile       String?
  targetFile       String?
  importSource     String?
  dependencyType   String     @default("import") // import, manifest, module_edge
  language         String?
  resolutionStatus String     @default("RESOLVED_INTERNAL") // RESOLVED_INTERNAL, RESOLVED_EXTERNAL, UNRESOLVED
  fromModule       String?
  toModule         String?
  name             String?
  version          String?
  purpose          String?
  status           String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt
  repo             Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, sourceFile])
  @@index([repoId, targetFile])
  @@index([repoId, kind])
  @@index([repoId, resolutionStatus])
  @@index([repoId, dependencyType])
}

model DeveloperRecord {
  id                 String     @id @default(cuid())
  repoId             String
  name               String
  role               String
  color              String
  coverage           Int        @default(70)
  blurb              String?
  recentContribution String?
  createdAt          DateTime   @default(now())
  repo               Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

model DocumentRecord {
  id          String     @id @default(cuid())
  repoId      String
  category    String
  title       String
  summary     String
  author      String
  status      String     // current, review, outdated
  coverage    Int        @default(90)
  contentJson String?    // Structured section JSON
  createdAt   DateTime   @default(now())
  repo        Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

model ActivityRecord {
  id            String     @id @default(cuid())
  repoId        String
  text          String
  byUser        String
  category      String
  icon          String
  timestampText String
  createdAt     DateTime   @default(now())
  repo          Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

model LearningProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model CommitRecord {
  id                     String                   @id @default(cuid())
  repoId                 String
  sha                    String
  shortSha               String
  message                String
  authorName             String
  authorEmail            String
  committerName          String?
  committerEmail         String?
  authoredAt             DateTime
  committedAt            DateTime
  parentShasJson         String                   @default("[]")
  branch                 String?
  commitUrl              String?
  authorContributorId    String?
  committerContributorId String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt
  repo                   Repository               @relation(fields: [repoId], references: [id], onDelete: Cascade)
  authorContributor      ContributorRecord?       @relation("AuthorCommits", fields: [authorContributorId], references: [id], onDelete: SetNull)
  committerContributor   ContributorRecord?       @relation("CommitterCommits", fields: [committerContributorId], references: [id], onDelete: SetNull)
  fileChanges            CommitFileChangeRecord[]

  @@unique([repoId, sha])
  @@index([repoId, committedAt])
  @@index([repoId, authorEmail])
  @@index([repoId, sha])
  @@index([repoId, authorContributorId])
  @@index([repoId, committerContributorId])
}

model CommitFileChangeRecord {
  id         String       @id @default(cuid())
  repoId     String
  commitId   String
  commitSha  String
  oldPath    String?
  newPath    String
  changeType String       // ADDED, MODIFIED, DELETED, RENAMED, COPIED, TYPE_CHANGED, UNKNOWN
  additions  Int          @default(0)
  deletions  Int          @default(0)
  similarity Int?
  isBinary   Boolean      @default(false)
  fileMode   String?
  createdAt  DateTime     @default(now())
  commit     CommitRecord @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@index([commitId])
  @@index([repoId, commitSha])
  @@index([repoId, newPath])
  @@index([repoId, oldPath])
  @@index([repoId, changeType])
}

model ContributorRecord {
  id                    String         @id @default(cuid())
  repoId                String
  identityKey           String
  name                  String
  email                 String?
  authoredCommitsCount  Int            @default(0)
  committedCommitsCount Int            @default(0)
  totalCommitsCount     Int            @default(0)
  additions             Int            @default(0)
  deletions             Int            @default(0)
  filesTouchedCount     Int            @default(0)
  filesTouchedJson      String         @default("[]")
  firstContributionAt   DateTime
  lastContributionAt    DateTime
  isAuthor              Boolean        @default(true)
  isCommitter           Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @default(now()) @updatedAt
  repo                  Repository     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  authoredCommits       CommitRecord[] @relation("AuthorCommits")
  committedCommits      CommitRecord[] @relation("CommitterCommits")

  @@unique([repoId, identityKey])
  @@index([repoId, totalCommitsCount])
  @@index([repoId, lastContributionAt])
  @@index([repoId, email])
  @@index([repoId, name])
}

model SyncJob {
  id            String     @id @default(cuid())
  repoId        String
  deliveryId    String?    @unique
  event         String     @default("push")
  status        String     @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  beforeSha     String?
  afterSha      String
  ref           String?
  isIncremental Boolean    @default(true)
  filesAdded    Int        @default(0)
  filesModified Int        @default(0)
  filesDeleted  Int        @default(0)
  error         String?
  summary       String?
  commitsJson   String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  repo          Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, status])
  @@index([deliveryId])
}

